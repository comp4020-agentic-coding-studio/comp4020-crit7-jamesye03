---
import "../styles.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const capReached = Astro.url.searchParams.get("error") === "cap";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav aria-label="site">
        <a href="/" class="brand">ANU Course Explorer</a>
        <a href="/courses/">Courses</a>
        <a href="/timetable/">My timetable</a>
      </nav>
    </header>
    <main>
      {
        capReached && (
          <p class="banner banner-error" role="alert">
            You've reached the 4-course limit — drop a course before adding another.
          </p>
        )
      }
      <slot />
    </main>
  </body>
</html>
