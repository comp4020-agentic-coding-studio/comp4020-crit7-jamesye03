---
import Base from "../../layouts/Base.astro";
import { MAX_ENROLMENTS, enrolledCourseIds, listCourses } from "../../lib/db";

const courses = listCourses();
const enrolled = enrolledCourseIds();
---

<Base title="Course catalog">
  <h1>Course catalog</h1>
  <p>Every course's full description is right here — no separate lookup required.</p>
  <p class="enrolment-count">
    {enrolled.size}/{MAX_ENROLMENTS} courses added.
  </p>
  <ul class="course-list">
    {
      courses.map((course) => {
        const isEnrolled = enrolled.has(course.id);
        return (
          <li class="course-card" style={{ borderInlineStartColor: course.color }}>
            <a class="course-card-link" href={`/courses/${course.code.toLowerCase()}/`}>
              <div class="course-card-heading">
                <p class="course-card-code">{course.code}</p>
                <h2 class="course-card-title">{course.title}</h2>
              </div>
              <p class="course-card-summary">{course.summary}</p>
            </a>
            <form method="post" action="/api/enrol" class="course-card-action">
              <input type="hidden" name="courseId" value={course.id} />
              <input type="hidden" name="back" value="/courses/" />
              {isEnrolled ? (
                <button type="submit" formaction="/api/drop" class="button-enrolled">
                  Enrolled
                </button>
              ) : (
                <button type="submit">Add</button>
              )}
            </form>
          </li>
        );
      })
    }
  </ul>
</Base>
